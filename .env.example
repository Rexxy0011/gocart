# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# Supabase — get these from your project's API settings
# (Project Settings → API → URL + anon public key + service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin shared password — anyone who types this on /admin/login gets a
# 24h admin session cookie. Independent of regular user auth so you can
# share the password without granting full account access. Pick a long
# random string (>= 24 chars). Rotating this signs every admin out.
# Example: ADMIN_PASSWORD=correct-horse-battery-staple-9a73
ADMIN_PASSWORD=

# Paystack — get these from dashboard.paystack.com → Settings → API Keys
# Test keys are stable; replace with pk_live_/sk_live_ in production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Public origin used by Paystack to redirect users back after payment.
# Override per environment (e.g. https://gocart.app in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone OTP uses Supabase's native phone auth, which delegates to a Twilio
# (or other) SMS provider configured in the Supabase dashboard:
#   Authentication → Providers → Phone → enable + paste Twilio creds
# No env vars needed in this app — it all flows through the existing
# NEXT_PUBLIC_SUPABASE_* variables and the user's session.

# Tier-1 verification (email + phone). Flip to "true" only after Twilio is
# configured in Supabase + Confirm-email is on, otherwise signed-in users
# get bounced to a /verify page that can't actually send OTPs.
VERIFICATION_REQUIRED=false

# Resend — transactional email (boost-expiry reminders, future receipts).
# Free tier: 3,000 sends/month. Sign up at resend.com → API Keys.
RESEND_API_KEY=
# From address. Must be on a domain you've verified in Resend, OR use
# their sandbox "onboarding@resend.dev" while testing.
RESEND_FROM_EMAIL=GoCart <onboarding@resend.dev>
# Where the "new user signed up" admin alert is sent. Leave blank to skip
# that email — welcome + sign-in emails to users are unaffected.
ADMIN_NOTIFY_EMAIL=rexxycael@gmail.com

# Vercel Cron secret. Vercel injects this as a Bearer token on every cron
# call; the route refuses anything else. Generate any random 32+ char
# string. Set the SAME value in Vercel → Settings → Environment Variables.
CRON_SECRET=
